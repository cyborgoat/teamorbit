{
  "name": "@goatcheese/teamorbit-client",
  "version": "0.2.2",
  "description": "Typed client for the teamorbit API",
  "keywords": [
    "teamorbit",
    "api-client",
    "openapi",
    "typescript",
    "fetch",
    "sdk"
  ],
  "homepage": "https://github.com/cyborgoat/teamorbit/tree/main/packages/client#readme",
  "bugs": {
    "url": "https://github.com/cyborgoat/teamorbit/issues"
  },
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyborgoat/teamorbit.git",
    "directory": "packages/client"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "openapi-typescript ../../openapi/openapi.json -o src/schema.d.ts && node scripts/readme-reference.mjs",
    "build": "npm run generate && tsc -p tsconfig.json && cp src/schema.d.ts dist/schema.d.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "openapi-fetch": "^0.13.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.6.0",
    "typescript": "^5.7.3"
  }
}
