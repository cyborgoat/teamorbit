generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERUSER
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
  SUSPENDED
  DELETED
}

model User {
  id           String     @id @default(uuid())
  username     String     @unique
  fullName     String
  email        String?    @unique
  passwordHash String
  role         Role       @default(USER)
  status       UserStatus @default(PENDING)
  avatarUrl    String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  events              Event[]
  announcements       Announcement[]
  news                News[]
  blogPosts           BlogPost[]
  notificationReads       NotificationRead[]
  notificationRecipients  NotificationRecipient[]
  notificationDismissals  NotificationDismissal[]
  forumPosts              ForumPost[]
  forumComments           ForumComment[]
  forumPostVotes          ForumPostVote[]
  forumCommentVotes       ForumCommentVote[]
}

model Event {
  id            String   @id @default(uuid())
  title         String
  description   String
  startAt       DateTime
  endAt         DateTime
  location      String
  coverImageUrl String?
  createdById   String
  createdBy     User     @relation(fields: [createdById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Announcement {
  id          String   @id @default(uuid())
  title       String
  description String
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model News {
  id            String   @id @default(uuid())
  title         String
  content       String
  tags          Tag[]
  coverImageUrl String?
  authorId      String
  author        User     @relation(fields: [authorId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model BlogPost {
  id            String   @id @default(uuid())
  title         String
  content       String
  tags          Tag[]
  coverImageUrl String?
  authorId      String
  author        User     @relation(fields: [authorId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum NotificationAudience {
  GLOBAL
  DIRECTED
}

model Notification {
  id           String               @id @default(uuid())
  audience     NotificationAudience @default(GLOBAL)
  type         String
  title        String
  body         String
  resourceType String
  resourceId   String
  createdAt    DateTime             @default(now())
  reads        NotificationRead[]
  recipients   NotificationRecipient[]
  dismissals   NotificationDismissal[]
}

model NotificationRecipient {
  id             String       @id @default(uuid())
  notificationId String
  userId         String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId])
}

model NotificationRead {
  id             String       @id @default(uuid())
  userId         String
  notificationId String
  readAt         DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id])
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationId])
}

model NotificationDismissal {
  id             String       @id @default(uuid())
  userId         String
  notificationId String
  dismissedAt    DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationId])
  @@index([userId])
}

model ForumPost {
  id        String   @id @default(uuid())
  title     String
  content   String
  score     Int      @default(0)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments ForumComment[]
  votes    ForumPostVote[]
}

model ForumComment {
  id        String   @id @default(uuid())
  content   String
  score     Int      @default(0)
  postId    String
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  parentId  String?
  parent    ForumComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   ForumComment[] @relation("CommentReplies")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  votes ForumCommentVote[]
}

model ForumPostVote {
  id        String    @id @default(uuid())
  value     Int
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, postId])
}

model ForumCommentVote {
  id        String       @id @default(uuid())
  value     Int
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  commentId String
  comment   ForumComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([userId, commentId])
}

model Tag {
  id String @id @default(uuid())
  name String @unique
  news News[]
  blogPosts BlogPost[]
}
