generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERUSER
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
  SUSPENDED
  DELETED
}

model User {
  id           String     @id @default(uuid())
  username     String     @unique
  fullName     String
  email        String?    @unique
  passwordHash String
  role         Role       @default(USER)
  status       UserStatus @default(PENDING)
  avatarUrl    String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  events                   Event[]
  eventRecipients          EventRecipient[]
  announcements            Announcement[]
  news                     News[]
  blogPosts                BlogPost[]
  notificationReads        NotificationRead[]
  notificationRecipients   NotificationRecipient[]
  notificationDismissals   NotificationDismissal[]
  forumPosts               ForumPost[]
  forumPostVotes           ForumPostVote[]
  comments                 Comment[]
  commentVotes             CommentVote[]
}

enum EventAudience {
  GLOBAL
  SELECTED
}

model Event {
  id            String        @id @default(uuid())
  title         String
  description   String
  startAt       DateTime
  endAt         DateTime
  location      String
  coverImageUrl String?
  audience      EventAudience @default(GLOBAL)
  createdById   String
  createdBy     User          @relation(fields: [createdById], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  recipients    EventRecipient[]
}

model EventRecipient {
  id      String @id @default(uuid())
  eventId String
  userId  String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
}

model Announcement {
  id          String   @id @default(uuid())
  title       String
  description String
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model News {
  id            String   @id @default(uuid())
  title         String
  content       String
  tags          Tag[]
  coverImageUrl String?
  authorId      String
  author        User     @relation(fields: [authorId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model BlogPost {
  id            String   @id @default(uuid())
  title         String
  content       String
  tags          Tag[]
  coverImageUrl String?
  authorId      String
  author        User     @relation(fields: [authorId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum NotificationAudience {
  GLOBAL
  DIRECTED
}

model Notification {
  id           String               @id @default(uuid())
  audience     NotificationAudience @default(GLOBAL)
  type         String
  title        String
  body         String
  resourceType String
  resourceId   String
  createdAt    DateTime             @default(now())
  reads        NotificationRead[]
  recipients   NotificationRecipient[]
  dismissals   NotificationDismissal[]
}

model NotificationRecipient {
  id             String       @id @default(uuid())
  notificationId String
  userId         String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId])
}

model NotificationRead {
  id             String       @id @default(uuid())
  userId         String
  notificationId String
  readAt         DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id])
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationId])
}

model NotificationDismissal {
  id             String       @id @default(uuid())
  userId         String
  notificationId String
  dismissedAt    DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationId])
  @@index([userId])
}

model ForumPost {
  id        String   @id @default(uuid())
  title     String
  content   String
  score     Int      @default(0)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  votes ForumPostVote[]
}

model ForumPostVote {
  id        String    @id @default(uuid())
  value     Int
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, postId])
}

model Comment {
  id           String   @id @default(uuid())
  content      String
  score        Int      @default(0)
  resourceType String
  resourceId   String
  authorId     String
  author       User     @relation(fields: [authorId], references: [id])
  parentId     String?
  parent       Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies      Comment[] @relation("CommentReplies")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  votes        CommentVote[]

  @@index([resourceType, resourceId])
}

model CommentVote {
  id        String   @id @default(uuid())
  value     Int
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, commentId])
}

model Tag {
  id        String     @id @default(uuid())
  name      String     @unique
  news      News[]
  blogPosts BlogPost[]
}

model UploadAsset {
  path           String   @id
  size           Int
  state          String   @default("ACTIVE")
  unreferencedAt DateTime?
  createdAt      DateTime @default(now())
  error          String?

  @@index([state, unreferencedAt])
}

// A shared SQLite write lock for media saves and cleanup claims, plus a run lease.
model UploadMaintenance {
  id         Int      @id
  revision   Int      @default(0)
  leaseOwner String?
  leaseUntil DateTime?
}

model UploadCleanupRun {
  id           String   @id @default(uuid())
  trigger      String
  actorId      String?
  status       String   @default("RUNNING")
  startedAt    DateTime @default(now())
  finishedAt   DateTime?
  deletedCount Int      @default(0)
  deletedBytes BigInt   @default(0)
  failedCount  Int      @default(0)
  error        String?
}
