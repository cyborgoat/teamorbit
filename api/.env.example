DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
UPLOAD_DIR=uploads
# First administrator only; set your own values before running prisma:seed.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=

# Orphan uploads: first sweep is one interval after startup; manual cleanup uses the same grace.
UPLOAD_CLEANUP_ENABLED=true
UPLOAD_CLEANUP_INTERVAL_HOURS=1
UPLOAD_CLEANUP_GRACE_HOURS=24
